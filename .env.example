# Copia este archivo como .env y completa tus credenciales locales
# MAIL_PASSWORD debe ser una Contraseña de aplicación de Google (16 caracteres), no tu clave normal.
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Opcional: URL pública HTTPS (ej. https://tu-tunel.trycloudflare.com) o déjalo vacío para detección automática
APP_BASE_URL=http://localhost:8080

# Opcional: orígenes permitidos por CORS separados por coma
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
